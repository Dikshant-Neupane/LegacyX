# ============================================
# LegacyX Backend — Environment Variables
# ============================================
# Copy to .env and fill in your values.

# Server
PORT=3001
HOST=0.0.0.0

# Solana RPC (devnet for MVP)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Fallback RPC endpoints (comma-separated)
SOLANA_RPC_FALLBACKS=https://rpc.ankr.com/solana_devnet,https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# LegacyX program ID
PROGRAM_ID=LGCYxV1111111111111111111111111111111111111

# Arweave wallet key (JSON stringified or path to file)
ARWEAVE_KEY=./arweave-wallet.json

# Arweave gateway
ARWEAVE_GATEWAY=https://arweave.net

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email / SMTP (for heir notifications and check-in reminders)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your@email.com
SMTP_PASS=YOUR_APP_PASSWORD

# JWT Secret (for session tokens)
JWT_SECRET=a-long-random-secret-string

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging level (debug | info | warn | error)
LOG_LEVEL=info
