# ============================================
# LegacyX MVP Backend — Environment Variables
# ============================================
# Copy to .env and fill in your values.

# Server
NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/legacyx?retryWrites=true&w=majority

# JWT Secret - generate a random 32+ character string
# Use: https://randomkeygen.com or openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-32-character-string

# Frontend URL (for CORS)
FRONTEND_URL=https://legacyx.vercel.app
