# ============================================
# LegacyX Frontend — Environment Variables
# ============================================
# Copy to .env.local and fill in your values.

# Solana RPC endpoint (devnet for MVP)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# LegacyX program ID (deployed Anchor program)
NEXT_PUBLIC_PROGRAM_ID=LGCYxV1111111111111111111111111111111111111

# Solana network (devnet | mainnet-beta | testnet)
NEXT_PUBLIC_NETWORK=devnet

# Backend API base URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Arweave gateway
NEXT_PUBLIC_ARWEAVE_GATEWAY=https://arweave.net

# Explorer base URLs
NEXT_PUBLIC_SOLSCAN_URL=https://solscan.io
NEXT_PUBLIC_EXPLORER_URL=https://explorer.solana.com
NEXT_PUBLIC_ORB_URL=https://xray.helius.xyz
